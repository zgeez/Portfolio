/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.log
/.modified
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
